# Backend microservice base URLs (see repo's docker-compose.yml for ports)
VITE_AUTH_URL=http://localhost:5000/api/auth
VITE_PRODUCT_URL=http://localhost:5001/api/products
VITE_CART_URL=http://localhost:5002/api/cart
VITE_ORDER_URL=http://localhost:5003/api/orders
VITE_PAYMENT_URL=http://localhost:5004/api/payment
VITE_AI_BUDDY_URL=http://localhost:5005
VITE_SELLER_URL=http://localhost:5007/api/seller

# Public Razorpay key (safe for the frontend) — must match RAZORPAY_KEY_ID
# used by the Payment service's .env
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
